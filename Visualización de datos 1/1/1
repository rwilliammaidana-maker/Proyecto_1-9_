<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Gráfica de Barras - GDP</title>
  <!-- D3.js v7 -->
  <script src="https://d3js.org/d3.v7.min.js"></script>
  <style>
    body {
      font-family: Arial, sans-serif;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      background-color: #f4f4f9;
      margin: 0;
      padding-top: 20px;
    }

    #title {
      font-size: 28px;
      margin-bottom: 20px;
      font-weight: bold;
    }

    svg {
      background-color: #ffffff;
      box-shadow: 0 4px 8px rgba(0,0,0,0.1);
      border-radius: 8px;
    }

    .bar {
      fill: #2a9d8f;
      transition: fill 0.2s;
    }

    .bar:hover {
      fill: #e76f51;
    }

    #tooltip {
      position: absolute;
      background-color: #333;
      color: #fff;
      padding: 8px 12px;
      border-radius: 4px;
      pointer-events: none;
      opacity: 0;
      font-size: 14px;
      text-align: center;
      box-shadow: 0 2px 5px rgba(0,0,0,0.2);
    }
  </style>
</head>
<body>

  <div id="tooltip"></div>

  <script>
    // Configuración de dimensiones
    const width = 800;
    const height = 400;
    const padding = 60;

    // Crear el contenedor SVG principal
    const svg = d3.select("body")
                  .append("svg")
                  .attr("width", width + padding * 2)
                  .attr("height", height + padding * 2);

    // Historia de usuario #1: Título con id="title"
    svg.append("text")
       .attr("id", "title")
       .attr("x", (width + padding * 2) / 2)
       .attr("y", padding / 1.5)
       .attr("text-anchor", "middle")
       .text("Gross Domestic Product");

    // Cargar los datos desde la API de freeCodeCamp
    const url = "https://raw.githubusercontent.com/freeCodeCamp/ProjectReferenceData/master/GDP-data.json";

    d3.json(url).then(data => {
      const dataset = data.data;

      // Procesar fechas para el eje X
      const yearsDate = dataset.map(item => new Date(item[0]));
      const xMin = d3.min(yearsDate);
      const xMax = d3.max(yearsDate);

      // Escala para el eje X (Tiempo)
      const xScale = d3.scaleTime()
                       .domain([xMin, xMax])
                       .range([padding, width + padding]);

      // Escala para el eje Y (Lineal para el GDP)
      const gdpMax = d3.max(dataset, item => item[1]);
      const yScale = d3.scaleLinear()
                       .domain([0, gdpMax])
                       .range([height + padding, padding]);

      // Generar ejes
      const xAxis = d3.axisBottom(xScale);
      const yAxis = d3.axisLeft(yScale);

      // Historia de usuario #2: Elemento g para el eje X con id="x-axis"
      svg.append("g")
         .attr("id", "x-axis")
         .attr("transform", `translate(0, ${height + padding})`)
         .call(xAxis);

      // Historia de usuario #3: Elemento g para el eje Y con id="y-axis"
      svg.append("g")
         .attr("id", "y-axis")
         .attr("transform", `translate(${padding}, 0)`)
         .call(yAxis);

      // Ancho dinámico de las barras
      const barWidth = width / dataset.length;

      // Tooltip dinámico
      const tooltip = d3.select("#tooltip");

      // Historias de usuario #5, #6, #7, #8, #9, #10, #11: Creación de barras rect
      svg.selectAll(".bar")
         .data(dataset)
         .enter()
         .append("rect")
         .attr("class", "bar")
         .attr("data-date", item => item[0])
         .attr("data-gdp", item => item[1])
         .attr("x", (item, i) => xScale(yearsDate[i]))
         .attr("y", item => yScale(item[1]))
         .attr("width", barWidth)
         .attr("height", item => (height + padding) - yScale(item[1]))
         // Historias de usuario #12 y #13: Tooltip interactivo con data-date
         .on("mouseover", (event, item) => {
           tooltip.transition()
                  .duration(200)
                  .style("opacity", 0.9);
           tooltip.html(`Fecha: ${item[0]}<br>GDP: $${item[1]} Billones`)
                  .attr("data-date", item[0])
                  .style("left", (event.pageX + 15) + "px")
                  .style("top", (event.pageY - 30) + "px");
         })
         .on("mouseout", () => {
           tooltip.transition()
                  .duration(200)
                  .style("opacity", 0);
         });
    });
  </script>

  <!-- Script de pruebas de freeCodeCamp -->
  <script src="https://cdn.freecodecamp.org/testable-projects-fcc/v1/bundle.js"></script>
</body>
</html>
